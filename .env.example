APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Default development untuk API/Alembic yang berjalan dari host lokal.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rf_nids
MODEL_PATH=models/random_forest_active.joblib
MODEL_METADATA_PATH=models/model_metadata.json
ALERT_CONFIDENCE_THRESHOLD=0.70
MAX_BATCH_SIZE=1000
MAX_PAGE_SIZE=100
LOG_LEVEL=INFO
LEAKAGE_COLUMNS_CONFIG=config/leakage_columns.json
FASTAPI_BASE_URL=http://localhost:8000
INGESTION_BATCH_SIZE=100
INGESTION_FLUSH_SECONDS=2
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2
# Explicit macOS interface used by scripts/run_live_capture.py (discover with --list-interfaces).
RF_NIDS_CAPTURE_INTERFACE=en0
CICFLOWMETER_EXECUTABLE=cicflowmeter
LIVE_FEATURE_COMPATIBILITY_POLICY=CICIDS2017_DATASET_ARTIFACT_REPRODUCTION
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_REQUEST_TIMEOUT=10
