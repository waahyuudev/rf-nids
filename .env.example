APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Default development untuk API/Alembic yang berjalan dari host lokal.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rf_nids
# RF-v2 is the default. Roll back with models/random_forest_active.joblib and
# models/model_metadata.json; restart the API so the configured pair is reloaded.
MODEL_PATH=models/experiment_d/random_forest_rf_v2.joblib
MODEL_METADATA_PATH=models/experiment_d/random_forest_rf_v2_runtime_metadata.json
MAX_BATCH_SIZE=1000
MAX_PAGE_SIZE=100
LOG_LEVEL=INFO
LEAKAGE_COLUMNS_CONFIG=config/leakage_columns.json
FASTAPI_BASE_URL=http://localhost:8000
INGESTION_BATCH_SIZE=100
INGESTION_FLUSH_SECONDS=2
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2
# Explicit macOS interface used by scripts/run_live_capture.py (discover with --list-interfaces).
RF_NIDS_CAPTURE_INTERFACE=en0
CICFLOWMETER_EXECUTABLE=cicflowmeter
LIVE_FEATURE_COMPATIBILITY_POLICY=CICIDS2017_DATASET_ARTIFACT_REPRODUCTION
DASHBOARD_REFRESH_SECONDS=5
DASHBOARD_REQUEST_TIMEOUT=10
# Phase 10 defensive runtime capture. Artifacts never enter frozen evidence paths.
RUNTIME_MONITORING_ROOT=data/runtime/monitoring
CAPTURE_WINDOW_SECONDS=10
CAPTURE_STOP_TIMEOUT_SECONDS=15
CICFLOWMETER_V3_IMAGE=rf-nids-cicflowmeter-v3:a26aae27
CICFLOWMETER_V3_IMAGE_DIGEST=sha256:0227c7280e586d54144b9bb11b2a6b5d4b1c4ba9bc7c44199fa312a6b829caab
EXTRACTION_TIMEOUT_SECONDS=120
